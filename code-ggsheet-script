var FIREBASE_URL = "https://wed-demo-d236a-default-rtdb.firebaseio.com/";
var SECRET_KEY = "51DfTBzUyx0OX9uUqe4L4Aeg5j6rEjOZ7nd5Q3PN";

function syncData() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getActiveSheet();
  
  try {
    // 1. TẢI DỮ LIỆU TỪ NÚT "history" TRÊN FIREBASE
    var response = UrlFetchApp.fetch(FIREBASE_URL + "history.json?auth=" + SECRET_KEY);
    var firebaseData = JSON.parse(response.getContentText());
    
    if (!firebaseData || typeof firebaseData !== 'object' || Object.keys(firebaseData).length === 0) {
      Logger.log("Không có dữ liệu lịch sử nào trên Firebase.");
      return;
    }
    
    // 2. CẤU HÌNH CỐ ĐỊNH CÁC CỘT DỮ LIỆU
    var fixedHeaders = ["Ngày_Firebase", "Thời_Gian_Máy", "pressure", "temperature"]; 
    var lastRow = sheet.getLastRow();
    
    // Nếu sheet mới hoàn toàn, tạo dòng tiêu đề
    if (lastRow === 0) {
      sheet.getRange(1, 1, 1, fixedHeaders.length).setValues([fixedHeaders]).setFontWeight("bold");
      lastRow = 1;
    }

    // 3. LẤY DANH SÁCH NGÀY_GIỜ ĐÃ CÓ TRÊN SHEET ĐỂ LỌC LỌC TRÙNG
    var existingCompositeKeys = [];
    if (lastRow > 1) {
      var existingDisplayData = sheet.getRange(2, 1, lastRow - 1, 2).getDisplayValues();
      existingCompositeKeys = existingDisplayData.map(function(row) {
        return row[0].toString().trim() + "_" + row[1].toString().trim();
      });
    }

    // 4. LỌC DỮ LIỆU MỚI TỪ FIREBASE
    var rowsToAppend = [];

    for (var dateKey in firebaseData) {
      var timeLogs = firebaseData[dateKey];
      if (!timeLogs || typeof timeLogs !== 'object') continue;

      for (var timeKey in timeLogs) {
        var fDate = dateKey.toString().trim();
        var fTime = timeKey.toString().trim();
        var compositeKey = fDate + "_" + fTime;
        
        // Nếu Ngày_Giờ này đã tồn tại trên Sheet rồi -> Bỏ qua
        if (existingCompositeKeys.indexOf(compositeKey) !== -1) {
          continue; 
        }

        var record = timeLogs[timeKey];
        if (!record || typeof record !== 'object') continue;

        var rowData = new Array(fixedHeaders.length).fill("");
        rowData[0] = fDate;  // Cột A: Ngày (YYYY-MM-DD)
        rowData[1] = fTime;  // Cột B: Giờ (HH-mm)

        for (var paramKey in record) {
          var colIndex = fixedHeaders.indexOf(paramKey);
          if (colIndex !== -1) {
            rowData[colIndex] = record[paramKey];
          }
        }
        rowsToAppend.push(rowData);
      }
    }

    // 5. GHI DỮ LIỆU MỚI VÀ TIẾN HÀNH SẮP XẾP THEO ĐÚNG NGÀY GIỜ
    if (rowsToAppend.length > 0) {
      // Nối dữ liệu mới vào cuối sheet trước
      sheet.getRange(sheet.getLastRow() + 1, 1, rowsToAppend.length, fixedHeaders.length).setValues(rowsToAppend);
      Logger.log("Đã lưu thêm " + rowsToAppend.length + " mốc dữ liệu mới.");
    }
    
    // THUẬT TOÁN TỰ ĐỘNG SẮP XẾP LẠI THEO NGÀY GIỜ CHUẨN:
    var updatedLastRow = sheet.getLastRow();
    if (updatedLastRow > 1) {
      // Chọn toàn bộ vùng dữ liệu từ dòng 2 đến hết bảng tính
      var sortRange = sheet.getRange(2, 1, updatedLastRow - 1, fixedHeaders.length);
      
      // Tiến hành Sort: Ưu tiên 1 xếp theo cột 1 (Ngày), Ưu tiên 2 xếp theo cột 2 (Giờ) tăng dần
      sortRange.sort([
        {column: 1, ascending: true}, 
        {column: 2, ascending: true}
      ]);
      Logger.log("Hệ thống đã tự động sắp xếp lại toàn bộ dữ liệu tịnh tiến theo đúng Ngày và Giờ gốc.");
    }

    // 6. GIỚI HẠN VÀ GIỮ SẠCH CÁC HÀNG TRỐNG
    var currentLastRow = sheet.getLastRow();
    var maxRows = sheet.getMaxRows();
    if (maxRows > currentLastRow + 5) {
      sheet.deleteRows(currentLastRow + 1, maxRows - currentLastRow);
    }

  } catch (e) {
    Logger.log("Lỗi đồng bộ hoặc sắp xếp dữ liệu: " + e.toString());
  }
}
