#include <Arduino.h>
#if defined(ESP8266)
  #include <ESP8266WiFi.h>
#elif defined(ESP32)
  #include <WiFi.h>
#endif
#include <ModbusIP_ESP8266.h>

const char* ssid     = "BAOTRI6";
const char* password = "";

IPAddress serverIP(192, 168, 2, 201); 
const uint16_t serverPort = 502;
const uint8_t SLAVE_ID = 2;

const uint16_t START_REG = 0x100;
const uint16_t SO_LUONG_REG = 2; // Đọc gộp 2 thanh ghi 0x100 và 0x101

uint16_t resBuffer[2] = {0}; 
ModbusIP mb;

bool dangChoData = false;
bool chuKyHoanThanh = false;
bool daChoDoiKetNoi = false; // Cờ chờ sau khi connect
unsigned long thoiGianKetNoi = 0;

void tinhToanFloat() {
    uint32_t data32 = ((uint32_t)resBuffer[1] << 16) | resBuffer[0];
    float ketQua;
    memcpy(&ketQua, &data32, sizeof(float));
    Serial.printf("\n🚀 KET QUA CUOI CUNG: %.3f\n", ketQua);
}

bool khiCoDuLieuVe(Modbus::ResultCode event, uint16_t transactionId, void* data) {
    dangChoData = false;
    chuKyHoanThanh = true;
    
    if (event == Modbus::EX_SUCCESS) {
        Serial.printf("👉 [OK] 0x100=%u, 0x101=%u\n", resBuffer[0], resBuffer[1]);
        tinhToanFloat();
    } else {
        Serial.printf("❌ [LOI] Ma loi: 0x%02X - Huy tinh toan\n", event);
    }
    return true;
}

void setup() {
    Serial.begin(115200);
    WiFi.begin(ssid, password);
    while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }
    Serial.println("\nWiFi OK!");
    mb.client();
}

void loop() {
    static unsigned long thoiGianTruoc = 0;
    unsigned long now = millis();

    // 1. Chu kỳ 15 giây (Tránh trùng nhịp với Node-RED 55s)
    if (now - thoiGianTruoc >= 15000) { 
        thoiGianTruoc = now;
        chuKyHoanThanh = false;
        daChoDoiKetNoi = false;
        Serial.println("\n🔄 === BAT DAU QUET ===");
    }

    if (!chuKyHoanThanh) {
        if (!mb.isConnected(serverIP)) {
            mb.connect(serverIP, serverPort);
        } else {
            // Lớp bảo vệ: Chờ 500ms sau khi connect để Gateway IFD506 ổn định
            if (!daChoDoiKetNoi) {
                if (thoiGianKetNoi == 0) thoiGianKetNoi = millis();
                if (millis() - thoiGianKetNoi > 500) {
                    daChoDoiKetNoi = true;
                }
            } 
            // Sau khi đã chờ đủ, mới gửi lệnh
            else if (!dangChoData) {
                dangChoData = true;
                mb.readHreg(serverIP, START_REG, resBuffer, SO_LUONG_REG, khiCoDuLieuVe, SLAVE_ID);
            }
        }
    } else {
        // Ngắt kết nối ngay khi xong để giải phóng tài nguyên Gateway
        if (mb.isConnected(serverIP)) {
            mb.disconnect(serverIP);
            thoiGianKetNoi = 0; // Reset timer cho lần sau
            Serial.println("[TCP] Ngắt kết nối.");
        }
    }

    mb.task();
    delay(10);
}
